# TRR-Backend setup adapter.
# Shared env ownership lives in ../docs/workspace/shared-env-manifest.json from the workspace root.
# Keep this file to backend setup values; profiles/*.env own workspace runtime modes.
# Copy this file to .env and fill in real values.
# Never commit .env (only .env.example is tracked).

# ----------------------------
# Core pipeline configuration
# ----------------------------

# Google Sheets (required)
SPREADSHEET_NAME=Realitease2025Data
SPREADSHEET_ID=your_google_sheet_id
GOOGLE_APPLICATION_CREDENTIALS=keys/service-account.json
# Optional alias used by some scripts
GOOGLE_SERVICE_ACCOUNT_FILE=

# API Keys
TMDB_API_KEY=your_tmdb_api_key
# Optional: TMDb v4 bearer token (preferred for new scripts; aliases TMDB_BEARER)
TMDB_BEARER_TOKEN=
TMDB_BEARER=
TMDB_LIST_ID=
TVDB_API_KEY=
# Legacy alias still recognized by older scripts.
THETVDB_API_KEY=

# Firecrawl (web scraping)
FIRECRAWL_API_KEY=

# OpenAI
OPENAI_API_KEY=

IMDB_API_KEY=your_imdb_api_key
IMDB_LIST_URL=https://www.imdb.com/list/your_list_id/

# IMDb Integration (Resilience & Fallback)
# OPTIONAL: Custom headers for IMDb HTML scraping (debugging/local unblock only)
# WARNING: Cookies are sensitive and expire frequently. Do NOT rely on this for production.
# The pipeline will automatically fall back to JSON API if HTML is blocked (202/403/429).
# Only use this for debugging specific shows or local development.
# Example: IMDB_EXTRA_HEADERS_JSON={"Cookie": "session=abc123", "User-Agent": "Custom UA"}
IMDB_EXTRA_HEADERS_JSON=

# Retry configuration for IMDb fullcredits HTML fetching
# Max retries AFTER first attempt (default: 2, meaning 3 total attempts)
IMDB_FULLCREDITS_MAX_RETRIES=2

# Base delay in seconds for exponential backoff (default: 5.0)
# Actual delay = base_delay * (2 ^ attempt) + random jitter
IMDB_FULLCREDITS_RETRY_BASE_DELAY_SEC=5.0

# Enable automatic fallback to JSON API on blocked HTML (default: 1)
# Set to 0 to disable fallback (for testing/rollback)
IMDB_FULLCREDITS_ENABLE_API_FALLBACK=1

# IMDb GraphQL API Configuration (Persisted Queries)
# GraphQL provides complete paginated cast data (vs JSON API's top-billed only)
# Primary endpoint for GraphQL persisted queries
IMDB_GRAPHQL_BASE_URL=https://caching.graphql.imdb.com/

# Fallback endpoint if primary fails
IMDB_GRAPHQL_FALLBACK_URL=https://api.graphql.imdb.com/

# Max retry attempts for GraphQL requests (default: 2)
IMDB_GRAPHQL_MAX_RETRIES=2

# Base delay for exponential backoff on GraphQL retries (default: 2.0)
IMDB_GRAPHQL_RETRY_BASE_DELAY_SEC=2.0

# Locale for GraphQL queries (default: en-US)
IMDB_GRAPHQL_LOCALE=en-US

# Request timeout in seconds (default: 30.0)
IMDB_GRAPHQL_TIMEOUT_SEC=30.0

# Persisted query hash overrides (optional)
# If IMDb rotates a hash, set to the new value discovered from browser DevTools
# Default: c2df29603060d12b6a76c48e2b47ac0ceee80e471f8cd8ee79abd672393e4bd8 (2026-01-15)
IMDB_GRAPHQL_HASH_TITLE_CREDIT_PAGINATION_V2=
# TitleEpisodeBottomSheetCredits - used for per-person episodic credits
# Default: 8af4e7a49ccd298796aec3d0aa5699c05a6b9efb23721f7eae98bb19b72eafa3
IMDB_GRAPHQL_HASH_TITLE_EPISODE_BOTTOM_SHEET_CREDITS=

# Pagination settings
# Page size for GraphQL pagination (default: 250)
IMDB_GRAPHQL_PAGE_SIZE=250

# Hard cap on pagination to prevent runaway queries (default: 10)
# If exceeded, result is marked as partial
IMDB_GRAPHQL_MAX_PAGES=10

# Cast Sync Configuration
# Primary data source for cast fallback chain (default: html)
# Options: "html" (conservative rollout) or "graphql" (maximum reliability)
# Determines tier order:
#   - html: HTML → GraphQL → JSON API (default)
#   - graphql: GraphQL → HTML → JSON API (more reliable)
IMDB_CAST_PRIMARY_SOURCE=html

# Min episodes required if cast member has no photo (default: 6)
# Cast members with > this many episodes are always included (regardless of photo)
# Cast members with <= this many episodes are only included if they have primaryImage
# This ensures we only store low-episode-count cast if we can visually represent them
# Job category filter (IMDB_JOB_CATEGORY_SELF) already excludes non-cast like archival footage
IMDB_SHOW_CAST_MIN_EPISODES_WITHOUT_PHOTO=6

# Max cast members per show as safety cap (default: 500)
# High limit to accommodate large reality TV casts
# Only marks as partial if exceeded (rare for normal shows)
IMDB_SHOW_CAST_MAX_MEMBERS=500

# Feature Flags
# Enable GraphQL fallback tier (default: 1)
# Set to 0 to disable GraphQL entirely (use only HTML + JSON API)
IMDB_GRAPHQL_ENABLED=1

# Gemini / Google AI
GEMINI_API_KEY=your_gemini_api_key
# Optional aliases used by some scripts
GOOGLE_GEMINI_API_KEY=
# Canonical model variable
GEMINI_MODEL=gemini-2.5-flash
# Optional route-specific overrides
GEMINI_MODEL_FAST=
GEMINI_MODEL_PRO=
# Optional compatibility alias
GOOGLE_GEMINI_MODEL=
# Deprecated fallback alias.
# Deprecation target: remove after 2026-06-30 once all environments migrate to GEMINI_MODEL.
GEMINI-MODEL=

# Optional tuning
REQUEST_DELAY=0.3
REALITEASE_TMDB_SHOW_LIMIT=5

# Firebase (optional)
FIREBASE_SERVICE_ACCOUNT_FILE=keys/firebase-admin-service-account.json
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=

# ----------------------------
# Database / core schema tools
# ----------------------------
# Local make dev direct lane. When present, this is preferred before session-pooler URLs.
TRR_DB_DIRECT_URL=
# Canonical runtime DB envs.
# Default deployed runtime lane should use Supavisor session mode (:5432 on pooler.supabase.com).
TRR_DB_SESSION_URL=
TRR_DB_URL=postgresql://postgres:postgres@localhost:5432/trr
# Optional transaction-mode Supavisor URL (:6543). Use only with a documented flight test.
TRR_DB_TRANSACTION_URL=
TRR_DB_RUNTIME_LANE=session
TRR_DB_TRANSACTION_FLIGHT_TEST=0
# Optional secondary DSN. Must also be a session-mode pooler URL (pooler.supabase.com:5432).
TRR_DB_FALLBACK_URL=
PGHOST=localhost
PGPORT=5432
PGDATABASE=trr
PGUSER=postgres
PGPASSWORD=
PGSSLMODE=require
# Database pool sizing for API + admin/social concurrency.
# Keep local session-mode pool sizing below the upstream Supavisor session cap
# so admin profile/comments pages do not self-saturate under parallel reads.
TRR_DB_POOL_MINCONN=1
TRR_DB_POOL_MAXCONN=2
# Set to 1 in Modal/runtime secrets so long-running scrapers release Supabase
# session-pool slots between DB operations.
TRR_DB_POOL_CLOSE_AFTER_RETURN=0
# Defaults to trr-backend:<pool_name> so pg_stat_activity can attribute holders.
# Override only with a non-secret label if an operator needs a deployment-specific name.
TRR_DB_APPLICATION_NAME=

# --- Connection Timeout ---
# TCP-level connect timeout in seconds. Prevents 2-minute OS hangs when DB is unreachable.
# Default: 10 seconds.
# TRR_DB_CONNECT_TIMEOUT_SECONDS=10

# --- Statement Timeout ---
# Default statement_timeout for all queries (milliseconds). Prevents runaway queries.
# Individual endpoints can override with SET LOCAL statement_timeout.
# Default: 30000 (30 seconds).
# TRR_DB_STATEMENT_TIMEOUT_MS=30000

# ----------------------------
# Supabase
# ----------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Supabase Client Timeouts (sync scripts)
# PostgREST timeout in seconds (default: 15)
SUPABASE_POSTGREST_TIMEOUT_SEC=15

# Storage operations timeout in seconds (default: 30)
SUPABASE_STORAGE_TIMEOUT_SEC=30

# HTTP pool timeout in seconds (default: 5) for timeout-validation helper usage
SUPABASE_HTTP_POOL_TIMEOUT_SEC=5

# ----------------------------
# Object Storage
# ----------------------------
# Canonical backend object-storage contract. Production uses Cloudflare R2.
OBJECT_STORAGE_PROVIDER=r2
OBJECT_STORAGE_BUCKET=trr-media-prod
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_SESSION_TOKEN=
OBJECT_STORAGE_PROFILE=
OBJECT_STORAGE_PUBLIC_BASE_URL=https://media.thereality.report
OBJECT_STORAGE_PREFIX=

# ----------------------------
# Credits V2 Migration (Phase 5)
# ----------------------------
# Enable dual-write to core.credits + core.credit_occurrences during sync
# Set to 1 after migrations 0065+0066 are applied and backfill is complete
ENABLE_CREDITS_V2_WRITE=0

# Enable reading from V2 views instead of legacy tables
# Set to 1 after ENABLE_CREDITS_V2_WRITE has been running and parity verified
ENABLE_CREDITS_V2_READ=0

# ----------------------------
# API Server (FastAPI)
# ----------------------------
# CORS allowed origins (comma-separated). If empty, allows all origins but disables credentials.
# Render/Vercel note: include the exact Vercel production and preview origins that should send credentials.
CORS_ALLOW_ORIGINS=

# Admin access control (comma-separated emails)
ADMIN_EMAIL_ALLOWLIST=

# Shared secret for TRR-APP internal admin proxy calls.
# Used to verify short-lived internal admin bearer JWTs from TRR-APP.
TRR_INTERNAL_ADMIN_SHARED_SECRET=
# Dev-only compatibility escape hatch for raw X-TRR-Internal-Admin-Secret requests.
# Leave unset in production.
TRR_INTERNAL_ADMIN_ALLOW_RAW_SECRET_FALLBACK=
# Dev-only service-role bypass for human-admin routes. Leave unset in production.
TRR_ADMIN_ALLOW_SERVICE_ROLE=
# Dev-only service-role bypass for internal-admin routes. Leave unset in production.
TRR_INTERNAL_ADMIN_ALLOW_SERVICE_ROLE=

# TRR API URL (this service)
TRR_API_URL=http://localhost:8000

# Better Stack / Logtail HTTP ingest for backend and Modal job logs.
# Recommended for the Render cutover steady state; default operator choice is Better Stack free first.
BETTER_STACK_SOURCE_TOKEN=
BETTER_STACK_INGESTING_HOST=in.logs.betterstack.com
BETTER_STACK_LOG_TIMEOUT_SECONDS=2.0
BETTER_STACK_FAILURE_COOLDOWN_SECONDS=60

# Sentry error monitoring (backend API + Modal jobs). Fully no-op unless SENTRY_DSN is set.
SENTRY_DSN=
TRR_DISABLE_SENTRY=
SENTRY_TRACES_SAMPLE_RATE=0.0
# Optional source-map / release upload (CI/build only):
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# NBCUMV / LightBox integration (AppSync GraphQL)
NBCUMV_APPSYNC_URL=https://bfg5dqxssngazhtsf6uo7bzdvm.appsync-api.us-west-2.amazonaws.com/graphql
NBCUMV_APPSYNC_API_KEY=
NBCUMV_BATCH_DOWNLOAD_URL=https://or1ukny4rd.execute-api.us-west-2.amazonaws.com/v1

# Google News async sync stale job timeout in minutes (default: 15)
GOOGLE_NEWS_SYNC_STALE_TIMEOUT_MINUTES=15

