SOCIAL_INSTAGRAM_COOKIES_FILE=
SOCIAL_INSTAGRAM_COOKIE_AUTO_REFRESH=true
SOCIAL_INSTAGRAM_COOKIE_VALIDATION_USERNAME=network_handle
SOCIAL_INSTAGRAM_COOKIE_VALIDATION_TTL_SECONDS=900
SOCIAL_INSTAGRAM_COOKIE_REFRESH_HEADLESS=true
SOCIAL_INSTAGRAM_COOKIE_REFRESH_TIMEOUT_SECONDS=120

