SOCIALBLADE_COOKIES_JSON=
SOCIALBLADE_COOKIES_FILE=
SOCIALBLADE_EMAIL=
SOCIALBLADE_PASSWORD=
SOCIALBLADE_FRESHNESS_HOURS=24
SOCIALBLADE_AUTO_REFRESH_ENABLED=true

# Inline JSON object for authenticated Instagram requests.
# Example: {"sessionid":"...","csrftoken":"...","ds_user_id":"...","lsd":"..."}
SOCIAL_INSTAGRAM_COOKIES_JSON=

