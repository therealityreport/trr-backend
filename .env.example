TRR_ADMIN_OPERATION_WORKER_ENABLED=0
TRR_ADMIN_OPERATION_WORKER_COUNT=1
TRR_ADMIN_OPERATION_WORKER_EXCLUDE_TYPES=
TRR_REDDIT_REFRESH_WORKER_ENABLED=0
TRR_REDDIT_REFRESH_WORKER_COUNT=1
TRR_GOOGLE_NEWS_WORKER_ENABLED=0
TRR_GOOGLE_NEWS_WORKER_COUNT=1
TRR_GOOGLE_NEWS_WORKER_LEASE_SECONDS=300
SOCIAL_QUEUE_ENABLED=true

# Instagram ingest pacing (seconds between requests).
SOCIAL_INSTAGRAM_DELAY_SEC=0.15
SOCIAL_INSTAGRAM_COMMENT_DELAY_SEC=0.25
# Posts lane proxy: set provider=decodo to route the cursor path through Decodo
# residential IPs. Defaults use sticky identity for authenticated posts so
# sibling shards do not multiply account reputation risk. Anonymous canaries
# are opt-in via SOCIAL_INSTAGRAM_POSTS_ANONYMOUS_ENABLED.
SOCIAL_INSTAGRAM_POSTS_PROXY_PROVIDER=decodo
SOCIAL_INSTAGRAM_POSTS_PROXY_URLS=
SOCIAL_INSTAGRAM_POSTS_USE_STICKY_PROXY=true
SOCIAL_INSTAGRAM_POSTS_ANONYMOUS_ENABLED=false
SOCIAL_INSTAGRAM_POSTS_PROXY_SESSION_TTL_SECONDS=600
SOCIAL_INSTAGRAM_POSTS_PAGE_PROXY_ROTATION_ENABLED=false
SOCIAL_INSTAGRAM_POSTS_HEADLESS=true
# Comments proxy config only applies to the Decodo/Smartproxy username:password path.
# Explicit SOCIAL_INSTAGRAM_COMMENTS_PROXY_URLS bypasses Decodo username shaping.
# Defaults use rotating/no-session Decodo usernames. Sticky mode appends
# -session-<stable-id>-sessionduration-<minutes> to the username only when
# SOCIAL_INSTAGRAM_COMMENTS_USE_STICKY_PROXY=true.
# SOCIAL_INSTAGRAM_COMMENTS_PROXY_SESSION_TTL_SECONDS is configured in seconds, then
# clamped and converted to whole minutes before the sessionduration suffix is added.
SOCIAL_INSTAGRAM_COMMENTS_PROXY_PROVIDER=none
SOCIAL_INSTAGRAM_COMMENTS_PROXY_URLS=
SOCIAL_INSTAGRAM_COMMENTS_USE_STICKY_PROXY=false
SOCIAL_INSTAGRAM_COMMENTS_PROXY_SHARD_SESSIONS=true
SOCIAL_INSTAGRAM_COMMENTS_PROXY_SESSION_TTL_SECONDS=600
SOCIAL_INSTAGRAM_COMMENTS_MAX_POSTS_PER_RUN=0
SOCIAL_INSTAGRAM_COMMENTS_MAX_COMMENTS_PER_POST=0
SOCIAL_INSTAGRAM_COMMENT_PAGINATION_MAX_PAGES=0
SOCIAL_INSTAGRAM_COMMENT_PAGINATION_MAX_SECONDS=180
SOCIAL_INSTAGRAM_COMMENTS_LAUNCH_AUTH_CHECK=false
SOCIAL_INSTAGRAM_REPLY_PAGINATION_MAX_PAGES=0
SOCIAL_INSTAGRAM_REPLY_PAGINATION_MAX_SECONDS=120
# Opt-in comments strategy that keeps one continuous post/session flow and saves once per post.
SOCIAL_INSTAGRAM_COMMENTS_SINGLE_SESSION_LOAD_ALL_ENABLED=false
SOCIAL_INSTAGRAM_COMMENTS_SINGLE_SESSION_RENDERED_CLICK_LIMIT=10
SOCIAL_INSTAGRAM_COMMENTS_SINGLE_SESSION_RENDERED_SCROLL_LIMIT=12
SOCIAL_INSTAGRAM_COMMENTS_SINGLE_SESSION_RENDERED_STALL_LIMIT=3
SOCIAL_INSTAGRAM_COMMENTS_SINGLE_SESSION_RENDERED_DEADLINE_SECONDS=45
SOCIAL_INSTAGRAM_COMMENTS_SINGLE_SESSION_MAX_IN_MEMORY_ROWS=5000
SOCIAL_INSTAGRAM_COMMENTS_HEADLESS=true
INSTAGRAM_BROWSER_NETWORK_POLICY_ENABLED=true
INSTAGRAM_BROWSER_BLOCK_STATIC_ASSETS=true
INSTAGRAM_BROWSER_DISABLE_EXTRA_RESOURCES=true
INSTAGRAM_BROWSER_NETWORK_POLICY_REPORT_ONLY=false
SOCIAL_INSTAGRAM_COMMENTS_PROFILE_SHARD_COUNT=8
SOCIAL_INSTAGRAM_COMMENTS_MAX_SHARD_COUNT=1000
SOCIAL_INSTAGRAM_COMMENTS_GLOBAL_RATE_LIMIT_MODE=advisory
# Per-post comments fetch overlap. Modal defaults use 2 with advisory global pacing; clamp is 1..8.
SOCIAL_INSTAGRAM_COMMENTS_PER_POST_CONCURRENCY=2
SOCIAL_INSTAGRAM_CATALOG_BACKFILL_FORCE_DETAIL_FETCH=true
SOCIAL_INSTAGRAM_DETAILS_REFRESH_LOCAL_WORKERS=4
SOCIAL_INSTAGRAM_DETAILS_REFRESH_MAX_DETAIL_FETCHES=500
# API-assisted comments-only run worker cap (applies to inline fallback and queue comments runs, min=1, max=8).
SOCIAL_COMMENTS_RUN_WORKERS=4
# Legacy alias kept for backwards compatibility when SOCIAL_COMMENTS_RUN_WORKERS is unset.
SOCIAL_INLINE_COMMENTS_WORKERS=4
# Optional persistent worker-pool profile (scripts/socials/start_worker_pool.sh).
SOCIAL_WORKER_MIN_STAGE_RUNNERS=6
SOCIAL_WORKER_ALLOW_STAGE_DISABLE=0
SOCIAL_WORKER_POOL_POSTS=8
SOCIAL_WORKER_POOL_COMMENTS=10
SOCIAL_WORKER_POOL_MEDIA_MIRROR=6
SOCIAL_WORKER_POOL_COMMENT_MEDIA_MIRROR=6
SOCIAL_WORKER_POOL_SHARED_ACCOUNT_DISCOVERY=3
SOCIAL_WORKER_POOL_SHARED_ACCOUNT_POSTS=5
SOCIAL_SHARED_ACCOUNT_POSTS_PLATFORM_CAP_INSTAGRAM=2
SOCIAL_WORKER_POOL_POST_CLASSIFY=10
SOCIAL_WORKER_POOL_SEASON_MATERIALIZE=10
SOCIAL_WORKER_POOL_ANALYTICS_REFRESH=4
SOCIAL_WORKER_POOL_INTERVAL_SEC=2
SOCIAL_RUN_IN_FLIGHT_CAP=24
SOCIAL_POSTS_COMMENTS_PLATFORM_CAP_INSTAGRAM=10
SOCIAL_POSTS_COMMENTS_PLATFORM_CAP_TIKTOK=1
SOCIAL_POSTS_COMMENTS_PLATFORM_CAP_TWITTER=1
SOCIAL_POSTS_COMMENTS_PLATFORM_CAP_YOUTUBE=1
SOCIAL_POSTS_COMMENTS_PLATFORM_CAP_FACEBOOK=1
SOCIAL_POSTS_COMMENTS_PLATFORM_CAP_THREADS=1
SOCIAL_MIRROR_PLATFORM_CAP=2
SOCIAL_JOB_STALE_SECONDS=300
SOCIAL_JOB_STALE_SECONDS_YOUTUBE_POSTS=900
SOCIAL_JOB_STALE_SECONDS_YOUTUBE_COMMENTS=600
SOCIAL_MODAL_DISPATCH_RETRY_DELAY_SECONDS=120
SOCIAL_MODAL_DISPATCH_LIMIT=25
SOCIAL_PLATFORM_CAP_PER_ACCOUNT_SCALING=false
SOCIAL_DB_UPSERT_BATCH_SIZE_COMMENTS=300
SOCIAL_DB_UPSERT_BATCH_SIZE_POSTS=100

# Social ingest debug assistant (System Health 🐛 action)
SOCIAL_DEBUG_OPENAI_MODEL=gpt-5.3-codex
SOCIAL_DEBUG_OPENAI_FALLBACK_MODEL=
SOCIAL_DEBUG_OPENAI_TIMEOUT_SECONDS=45
SOCIAL_DEBUG_CONTEXT_MAX_BYTES=18000
SOCIAL_DEBUG_PATCH_MAX_BYTES=200000
SOCIAL_DEBUG_PATCH_APPLY_ENABLED=false

# Optional contextual sentiment disambiguation for season social analytics.
# Disabled by default; rule-based analyzer is always used as the baseline.
SOCIAL_SENTIMENT_GEMINI_ENABLED=false
# Falls back to GOOGLE_GEMINI_MODEL / GEMINI_MODEL / gemini-2.5-flash when unset.
SOCIAL_SENTIMENT_GEMINI_MODEL=
# Max ambiguous comments sent to Gemini per analytics request (hard-capped in code).
SOCIAL_SENTIMENT_GEMINI_MAX_COMMENTS=40
# Batch size for Gemini requests (hard-capped in code).
SOCIAL_SENTIMENT_GEMINI_BATCH_SIZE=10

BRANDFETCH_API_KEY=
BRANDFETCH_TIMEOUT_SEC=20
