{
  "name": "TRR Instagram Catalog Backfill (Credential)",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        260,
        320
      ]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "baseUrl",
              "value": "https://trr-backend-api.onrender.com"
            },
            {
              "name": "platform",
              "value": "instagram"
            },
            {
              "name": "accountHandle",
              "value": "bravotv"
            },
            {
              "name": "sourceScope",
              "value": "bravo"
            },
            {
              "name": "backfillScope",
              "value": "full_history"
            },
            {
              "name": "dateStartIso",
              "value": ""
            },
            {
              "name": "dateEndIso",
              "value": ""
            }
          ],
          "number": [
            {
              "name": "pollSeconds",
              "value": 20
            }
          ],
          "boolean": [
            {
              "name": "allowInlineDevFallback",
              "value": false
            }
          ]
        }
      },
      "id": "set-config",
      "name": "Set Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        500,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "const baseUrl = String($json.baseUrl || '').replace(/\\/$/, '');\nconst platform = String($json.platform || 'instagram').trim();\nconst accountHandle = String($json.accountHandle || '').trim();\nconst backfillScope = String($json.backfillScope || 'full_history').trim() || 'full_history';\nif (!baseUrl) {\n  throw new Error('Set Config.baseUrl is required');\n}\nif (!accountHandle) {\n  throw new Error('Set Config.accountHandle is required');\n}\nconst requestBody = {\n  source_scope: String($json.sourceScope || 'bravo'),\n  backfill_scope: backfillScope,\n  allow_inline_dev_fallback: Boolean($json.allowInlineDevFallback || false)\n};\nconst dateStartIso = String($json.dateStartIso || '').trim();\nconst dateEndIso = String($json.dateEndIso || '').trim();\nif (backfillScope === 'bounded_window') {\n  if (dateStartIso) requestBody.date_start = dateStartIso;\n  if (dateEndIso) requestBody.date_end = dateEndIso;\n}\nreturn [{\n  json: {\n    ...$json,\n    startUrl: `${baseUrl}/api/v1/admin/socials/profiles/${platform}/${accountHandle}/catalog/backfill`,\n    requestBody\n  }\n}];"
      },
      "id": "build-start-request",
      "name": "Build Start Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        320
      ]
    },
    {
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "method": "POST",
        "url": "={{ $json.startUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "bodyParametersJson": "={{ JSON.stringify($json.requestBody) }}"
      },
      "id": "start-run",
      "name": "Start Run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        980,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "const runId = String($json.run_id || '').trim();\nconst platform = String($json.platform || 'instagram').trim();\nconst accountHandle = String($json.account_handle || $item(0).$node['Set Config'].json.accountHandle || '').trim();\nconst baseUrl = String($item(0).$node['Set Config'].json.baseUrl || '').replace(/\\/$/, '');\nconst pollSeconds = Number($item(0).$node['Set Config'].json.pollSeconds || 20);\nif (!runId) {\n  throw new Error(`Start Run did not return run_id: ${JSON.stringify($json)}`);\n}\nreturn [{\n  json: {\n    ...$json,\n    baseUrl,\n    platform,\n    accountHandle,\n    runId,\n    pollSeconds,\n    pollUrl: `${baseUrl}/api/v1/admin/socials/profiles/${platform}/${accountHandle}/catalog/runs/${runId}/progress`\n  }\n}];"
      },
      "id": "normalize-start-response",
      "name": "Normalize Start Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1220,
        320
      ]
    },
    {
      "parameters": {
        "amount": "={{ $json.pollSeconds }}",
        "unit": "seconds"
      },
      "id": "wait-before-poll",
      "name": "Wait Before Poll",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1460,
        320
      ]
    },
    {
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "method": "GET",
        "url": "={{ $json.pollUrl }}"
      },
      "id": "poll-progress",
      "name": "Poll Progress",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1700,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "const status = String($json.status || '').trim().toLowerCase();\nconst terminal = ['completed', 'failed', 'cancelled'].includes(status);\nreturn [{ json: { ...$json, terminal, normalizedStatus: status } }];"
      },
      "id": "check-terminal-state",
      "name": "Check Terminal State",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1940,
        320
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.terminal }}",
              "operation": "isTrue"
            }
          ]
        }
      },
      "id": "if-terminal",
      "name": "If Terminal",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2180,
        320
      ]
    }
  ],
