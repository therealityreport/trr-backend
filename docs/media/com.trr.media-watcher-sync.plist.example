<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.trr.media-watcher-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON_EXECUTABLE__</string>
    <string>__SYNC_SCRIPT__</string>
    <string>--watch-id</string>
    <string>__WATCH_ID__</string>
    <string>--destination-label</string>
    <string>__DESTINATION_LABEL__</string>
    <string>--config</string>
    <string>__LOCAL_CONFIG_PATH__</string>
  </array>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__LOCAL_LOG_PATH__</string>
  <key>StandardErrorPath</key>
  <string>__LOCAL_ERROR_LOG_PATH__</string>
</dict>
</plist>
